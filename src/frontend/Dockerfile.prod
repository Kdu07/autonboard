# Estágio 1: Build (Compila o Angular para arquivos estáticos)
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build -- --configuration production

# Estágio 2: Produção (Servir com Nginx + SSL auto-assinado)
FROM nginx:alpine
RUN apk add --no-cache openssl

# Gera certificado SSL auto-assinado para suportar HTTPS (exigido pelo Auth0)
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/selfsigned.key \
    -out /etc/nginx/ssl/selfsigned.crt \
    -subj "/C=BR/ST=SP/L=SaoPaulo/O=G01/CN=localhost"

# Copia os arquivos Angular e a config customizada do Nginx
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
EXPOSE 443
CMD ["nginx", "-g", "daemon off;"]
